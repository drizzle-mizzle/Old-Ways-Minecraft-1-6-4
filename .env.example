# Секреты развёртывания. Скопируйте в .env рядом и задайте свои значения —
# docker compose подхватит их сам. Сам .env в репозиторий не попадает.

# Пароль консоли сервера (RCON). Им сервис авторизации выбивает из мира игрока,
# чей пропуск погас: второй вход в тот же аккаунт или смена пароля.
# Порт наружу не публикуется, но пароль всё равно должен быть длинным:
# доступ к RCON — это доступ ко всем командам сервера.
#   генерация: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Пусто — RCON не поднимается, всё остальное работает как раньше.
OW_RCON_PASSWORD=

# Порт RCON внутри сети compose. Менять незачем, но пусть будет видно.
OW_RCON_PORT=25575
