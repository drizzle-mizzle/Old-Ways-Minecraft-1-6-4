# Портативная Java (98 МБ windows-бинарников) — ставится скриптом из шага 01
jre8/

# Миры — состояние, а не конфигурация
world/
world_nether/
world_the_end/

# Зеркало набора запуска клиента (~126 МБ) — восстанавливается
# командой python tools/fetch_client.py по манифестам из client/
mirror/

# Раздача для лаунчера — собирается из зеркала командой tools/build_dist.py
dist/

# JDK 8 для сборки лаунчера (192 МБ). Ставится так же, как jre8:
# Temurin 8u504 с adoptium.net, распаковать под этим именем
jdk8/

# MinGW-w64 для сборки exe-запускателя (693 МБ), только для сборки:
# github.com/niXman/mingw-builds-binaries, вариант posix-seh-msvcrt
mingw64/

# Собранный лаунчер
launcher/build/
coremod/build/

# Ядро, пропатченное на свой сервис авторизации — делается из боевого
# командой tools/patch_jars.py, в репозитории ему делать нечего
server-auth.jar

# Логи и служебное
*.log
cache/
backups/

# Состояние плагинов: в репозитории живут только настройки
plugins/Towny/data/
plugins/Towny/backup/
plugins/Towny/logs/
plugins/Heroes/players/
plugins/Heroes/storage/
plugins/Essentials/userdata/
# Звёздочка, а не каталог: исключённую папку обратно не вернуть,
# а её содержимое — можно, и общая настройка метрик едет в релиз.
plugins/PluginMetrics/*
!plugins/PluginMetrics/config.yml
plugins/**/*.db
*~

# Python
__pycache__/
*.pyc

# Секреты развёртывания (пароль RCON и прочее) — рядом лежит .env.example
.env
